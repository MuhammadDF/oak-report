PRICE_CHARTING=your-price-charting-api-key
PRICING_CATALOG_REFRESH_ENABLED=true
PRICING_CATALOG_REFRESH_INTERVAL_SECONDS=604800
PRICING_CATALOG_REFRESH_ON_STARTUP=true
# Leave blank for local Vite proxying and Firebase Hosting /api rewrites.
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
DATA_PROVIDER=postgres

# Compose DB selection (preferred for docker compose):
# If APP_DATABASE_URL is set, backend uses it directly.
# If APP_DATABASE_URL is empty, backend builds URL from DB_* values below.
APP_DATABASE_URL=
DB_NAME=pokemon
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432

GOOGLE_CLOUD_PROJECT=GOOGLE_CLOUD_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Local non-compose backend run compatibility:
# uv run uvicorn backend.main:app --host 0.0.0.0 --port 8000 (need to have uv installed)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pokemon
# POSTGRES_DB=pokemon
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# External DB example (compose):
# APP_DATABASE_URL=postgresql+asyncpg://postgres:your_password@host.docker.internal:5433/pokemon
# DB_NAME=pokemon
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=host.docker.internal
# DB_PORT=5433
