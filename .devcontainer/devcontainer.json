{
  "name": "oak-report-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "root",
  "forwardPorts": [5173, 8000],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "uv sync && cd frontend && npm install",
  "postStartCommand": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "openai.chatgpt",
        "GitHub.copilot-chat",
        "Anthropic.claude-code",
        "google.geminicodeassist",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${localWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true
      }
    }
  },
  "containerEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "DATA_PROVIDER": "postgres",
    "DATABASE_URL": "postgresql+asyncpg://postgres:password@postgres:5432/pokemon",
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": "5432",
    "POSTGRES_DB": "pokemon",
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "password"
  }
}
